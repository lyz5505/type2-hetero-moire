Cell[CellGroupData[{

Cell["4. Fixed 55 nm code (slides 3, 5, 6)", "Section",ExpressionUUID->"4ca6c254-c6f8-3f4a-8800-3579288bb37a"],

Cell["\<\
From \"heavy fermion material all.nb\". Here TotalHam3[k, M, V, Lambda] \
(moire length fixed to 55 nm). Same atomic model as section 2.\
\>", "Text",ExpressionUUID->"f7c4858a-3d8d-564a-b6c4-ae85ad0dd671"],
,

Cell[BoxData[
 RowBox[{
  RowBox[{"n", "=", "6"}], ";", 
  RowBox[{"Glength", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{"i", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"n", "+", "1"}], ",", 
         RowBox[{"2", "n"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"2", "n"}], "+", "1"}], "}"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{"i", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"2", "n"}], ",", 
         RowBox[{"n", "+", "1"}], ",", 
         RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], "]"}]}], ";", 
  RowBox[{"Gbegin", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Total", "@", 
       RowBox[{"Glength", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "i"}], "]"}], "]"}]}], "-", 
      RowBox[{"Glength", "[", 
       RowBox[{"[", "i", "]"}], "]"}], "+", "1"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "Glength", "]"}]}], "}"}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"G", "[", "\[Theta]_", "]"}], ":=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"ArrayFlatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"n", "-", "i"}], ")"}], 
           RowBox[{"gg5", "[", " ", "\[Theta]", "]"}]}], "+", 
          RowBox[{"j", " ", 
           RowBox[{"gg1", "[", " ", "\[Theta]", "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", "n"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"-", "i"}], ",", "n"}], "}"}]}], "]"}], ",", "1"}], "]"}], 
     ",", 
     RowBox[{"ArrayFlatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"-", "i"}], ")"}], 
           RowBox[{"gg5", "[", " ", "\[Theta]", "]"}]}], "+", 
          RowBox[{"j", " ", 
           RowBox[{"gg1", "[", " ", "\[Theta]", "]"}]}]}], ",", 
