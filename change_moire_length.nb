Cell[BoxData[
 RowBox[{
  RowBox[{"off", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Total", "@", "Glength"}], ",", 
         RowBox[{"Total", "@", "Glength"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "3"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"N", "@", 
          RowBox[{"Norm", "[", 
           RowBox[{
            RowBox[{"Gtest", "[", 
