Cell[BoxData[
 RowBox[{
  RowBox[{"BC", "[", 
   RowBox[{"{", 
    RowBox[{"kx_", ",", "ky_"}], "}"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"t", "=", 
       RowBox[{"Eighalf", "[", 
        RowBox[{"{", 
         RowBox[{"kx", ",", "ky"}], "}"}], "]"}]}], ",", 
      RowBox[{"tdx", "=", 
       RowBox[{"Eighalf", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"kx", "+", "dk"}], ",", "ky"}], "}"}], "]"}]}], ",", 
      RowBox[{"tdy", "=", 
       RowBox[{"Eighalf", "[", 
        RowBox[{"{", 
         RowBox[{"kx", ",", 
          RowBox[{"ky", "+", "dk"}]}], "}"}], "]"}]}], ",", 
      RowBox[{"tdydx", "=", 
       RowBox[{"Eighalf", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"kx", "+", "dk"}], ",", 
          RowBox[{"ky", "+", "dk"}]}], "}"}], "]"}]}]}], "}"}], ",", 
    RowBox[{"-", 
     RowBox[{"Im", "@", 
      RowBox[{"Log", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Conjugate", "[", "t", "]"}], ".", "tdx"}], ")"}], 
        RowBox[{"(", " ", 
         RowBox[{
          RowBox[{"Conjugate", "[", "tdx", "]"}], ".", "tdydx"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Conjugate", "[", "tdydx", "]"}], ".", "tdy"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Conjugate", "[", "tdy", "]"}], ".", "t"}], ")"}]}], 
       "]"}]}]}]}], "]"}]}]], "Input",
 CellLabel->"In[83]:=",ExpressionUUID->"5c6f7156-ab26-374d-9aab-8bbf9bfef38b"],

