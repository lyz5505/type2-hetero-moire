Cell[BoxData[
 RowBox[{
  RowBox[{"HInt", "=", 
   RowBox[{"Normal", "@", 
    RowBox[{"BlockDiagonalMatrix", "@", 
     RowBox[{"ParallelTable", "[", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Hup", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"kx", ",", "ky"}], "}"}], "+", 
           RowBox[{
            RowBox[{"G", "[", "TA", "]"}], "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ",", "M"}], "]"}], "+", 
        RowBox[{"10", "  ", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Total", "@", "Glength"}]}], "}"}]}], "]"}]}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[28]:=",ExpressionUUID->"3c652003-69c5-b649-aee1-3dd975bce4f8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"diagH", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"kxx_", ",", "kyy_"}], "}"}], ",", "MM_", ",", "TTA_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"N", "@", 
    RowBox[{"Chop", "@", "HInt"}]}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"kx", "->", "kxx"}], ",", 
     RowBox[{"ky", "->", "kyy"}], ",", 
