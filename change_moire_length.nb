Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ESGEhalf", "[", 
    RowBox[{"k_List", ",", "n_", ",", "M_", ",", "v_", ",", "Lambda_"}], 
    "]"}], ":=", 
   RowBox[{"Normalize", "@", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Eigenvectors", "[", 
      RowBox[{
       RowBox[{"TotalHam3", "[", 
        RowBox[{"k", ",", "M", ",", "v", ",", "Lambda"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"dim", "/", "2"}], "+", "n"}], "}"}]}], "]"}], "]"}]}]}], ";", 
  RowBox[{
   RowBox[{"Eighalf", "[", "k_List", "]"}], ":=", 
   RowBox[{"N", "@", 
    RowBox[{"Chop", "@", 
     RowBox[{"ESGEhalf", "[", 
      RowBox[{"k", ",", "1", ",", 
       RowBox[{"-", "0.016"}], ",", "1"}], "]"}]}]}]}]}]], "Input",
 CellLabel->"In[77]:=",ExpressionUUID->"2fa6c86e-5e18-b341-a52e-58a9334dd77d"],

