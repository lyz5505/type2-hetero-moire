Cell[CellGroupData[{

Cell["2. Non-moire model (HgCl2/TiTe2)", "Section",ExpressionUUID->"2c760849-ddca-f04c-abfc-1ec50fa24326"],

Cell["\<\
a0 = 0.373 nm. Hup/Hdown are exactly the spin blocks of the Fig. 4(b) model \
(Hfit4Best, SI Eq. 11) with q = a0 k, plus the mass shift M diag(1,-1). \
Identical in both source notebooks. The moire calculations use Hup only.\
\>", "Text",ExpressionUUID->"ef42ca66-879d-374f-a549-cc3312db0663"],
,

Cell[BoxData[
 RowBox[{"\n", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"a0", "=", "0.373"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"E1", "=", "0.024"}], ";"}], "               ", 
   RowBox[{"(*", "eV", "*)"}], "\n", 
   RowBox[{
    RowBox[{"E2", "=", 
     RowBox[{"-", "0.024"}]}], ";"}], "              ", 
   RowBox[{"(*", "eV", "*)"}], "\n", 
   RowBox[{
    RowBox[{"A1", "=", 
     RowBox[{"0.4714", " ", 
      RowBox[{"a0", "^", "2"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"B0", "=", 
     RowBox[{"0.09096", " ", "a0"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"A2", "=", 
     RowBox[{
      RowBox[{"-", "0.1558"}], " ", 
      RowBox[{"a0", "^", "2"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"w3", "=", 
     RowBox[{"0.2034", " ", 
      RowBox[{"a0", "^", "3"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lambda4", "=", 
     RowBox[{
      RowBox[{"-", "0.02154"}], " ", 
      RowBox[{"a0", "^", "4"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"eV", " ", 
     RowBox[{"nm", "^", "4"}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Hup", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"kx_", ",", "ky_"}], "}"}], ",", "M_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"E1", "+", 
           RowBox[{"A1", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", "^", "2"}], "+", 
              RowBox[{"ky", "^", "2"}]}], ")"}]}]}], ",", 
          RowBox[{"I", " ", "B0", " ", 
           RowBox[{"(", 
            RowBox[{"kx", "+", 
             RowBox[{"I", " ", "ky"}]}], ")"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "I"}], " ", "B0", " ", 
           RowBox[{"(", 
            RowBox[{"kx", "-", 
             RowBox[{"I", " ", "ky"}]}], ")"}]}], ",", 
          RowBox[{"E2", "-", 
           RowBox[{"w3", " ", "ky", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"3", " ", 
               RowBox[{"kx", "^", "2"}]}], "-", 
              RowBox[{"ky", "^", "2"}]}], ")"}]}], "+", 
           RowBox[{"A2", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", "^", "2"}], "+", 
              RowBox[{"ky", "^", "2"}]}], ")"}]}], "+", 
           RowBox[{"lambda4", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"kx", "^", "2"}], "+", 
               RowBox[{"ky", "^", "2"}]}], ")"}], "^", "2"}]}]}]}], "}"}]}], 
       "}"}], "+", 
      RowBox[{"M", " ", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "}"}], "]"}]}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Hdown", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"kx_", ",", "ky_"}], "}"}], ",", "M_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"E1", "+", 
           RowBox[{"A1", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", "^", "2"}], "+", 
              RowBox[{"ky", "^", "2"}]}], ")"}]}]}], ",", 
          RowBox[{"I", " ", "B0", " ", 
           RowBox[{"(", 
            RowBox[{"kx", "-", 
             RowBox[{"I", " ", "ky"}]}], ")"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "I"}], " ", "B0", " ", 
           RowBox[{"(", 
            RowBox[{"kx", "+", 
             RowBox[{"I", " ", "ky"}]}], ")"}]}], ",", 
          RowBox[{"E2", "+", 
           RowBox[{"w3", " ", "ky", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"3", " ", 
               RowBox[{"kx", "^", "2"}]}], "-", 
              RowBox[{"ky", "^", "2"}]}], ")"}]}], "+", 
           RowBox[{"A2", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", "^", "2"}], "+", 
              RowBox[{"ky", "^", "2"}]}], ")"}]}], "+", 
           RowBox[{"lambda4", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"kx", "^", "2"}], "+", 
               RowBox[{"ky", "^", "2"}]}], ")"}], "^", "2"}]}]}]}], "}"}]}], 
       "}"}], "+", 
      RowBox[{"M", " ", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "}"}], "]"}]}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]"}]}]], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"14a996d8-58b1-0941-8a0f-f49406374fb3"],

