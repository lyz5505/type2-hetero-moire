Cell[CellGroupData[{

Cell["3. Moire Hamiltonian with variable moire length (slides 2-4)", "Section",ExpressionUUID->"c4fe67b2-d79b-3b45-827f-fffde2f8a305"],

Cell["\<\
TotalHam3[k, M, TA, V, Lambda]: M = Delta m, TA = 1/(moire length in nm), V = \
potential amplitude, Lambda = ratio of conduction- to valence-band potential \
(Lambda = 0: potential only on the valence band).\
\>", "Text",ExpressionUUID->"66a0574c-c29d-0e4b-878a-7f9bcc5aa68d"],
,

Cell[BoxData[
 RowBox[{
  RowBox[{"n", "=", "6"}], ";", 
  RowBox[{"Glength", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{"i", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"n", "+", "1"}], ",", 
         RowBox[{"2", "n"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"2", "n"}], "+", "1"}], "}"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{"i", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"2", "n"}], ",", 
         RowBox[{"n", "+", "1"}], ",", 
         RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], "]"}]}], ";", 
  RowBox[{"Gbegin", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Total", "@", 
       RowBox[{"Glength", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "i"}], "]"}], "]"}]}], "-", 
      RowBox[{"Glength", "[", 
       RowBox[{"[", "i", "]"}], "]"}], "+", "1"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "Glength", "]"}]}], "}"}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"G", "[", "\[Theta]_", "]"}], ":=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"ArrayFlatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"n", "-", "i"}], ")"}], 
           RowBox[{"gg5", "[", " ", "\[Theta]", "]"}]}], "+", 
          RowBox[{"j", " ", 
           RowBox[{"gg1", "[", " ", "\[Theta]", "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", "n"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"-", "i"}], ",", "n"}], "}"}]}], "]"}], ",", "1"}], "]"}], 
     ",", 
     RowBox[{"ArrayFlatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"-", "i"}], ")"}], 
           RowBox[{"gg5", "[", " ", "\[Theta]", "]"}]}], "+", 
          RowBox[{"j", " ", 
           RowBox[{"gg1", "[", " ", "\[Theta]", "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"-", "n"}], ",", 
           RowBox[{"n", "-", "i"}]}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
    "]"}]}], ";", 
  RowBox[{"Graphics", "[", 
   RowBox[{"Point", "[", 
    RowBox[{"G", "[", "1", "]"}], "]"}], "]"}], ";"}]], "Input",
 CellLabel->"In[25]:=",ExpressionUUID->"420b8ec6-aa9c-dd4c-ba33-637de7c6c019"],

