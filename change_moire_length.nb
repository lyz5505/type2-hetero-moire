Cell[CellGroupData[{

Cell["Slide 4: Delta E0 versus moire length", "Subsection",ExpressionUUID->"079ed048-572b-2842-8dc5-dd8d5bd52395"],

Cell["\<\
Plotf[i] computes the bands at moire length nList[[i]] and Delta m = \
MmagicList[[i]]; result collects Delta E0 (meV) for all 11 lengths (11 \
band-structure calculations). gapMeVList holds the values obtained from it \
and is plotted directly.\
\>", "Text",ExpressionUUID->"47c7165f-4a76-704c-87e5-844f170caa5f"],

,

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Plotf", "[", "i_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", 
     RowBox[{
      RowBox[{"TA1", "=", 
       RowBox[{"1", "/", 
        RowBox[{"nList", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}]}], ";", 
      RowBox[{"temp2", " ", "=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "kpath1", "}"}], ",", 
         RowBox[{
          RowBox[{"kpath1", "=", 
           RowBox[{"Kpath", "[", "TA1", "]"}]}], ";", 
          RowBox[{"Transpose", "@", 
           RowBox[{"ParallelTable", "[", 
            RowBox[{
             RowBox[{"Sort", "@", 
              RowBox[{"Eigenvalues", "[", 
               RowBox[{"TotalHam3", "[", 
                RowBox[{"k", ",", 
                 RowBox[{"MmagicList", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", "TA1", ",", "1", ",", 
                 "0"}], "]"}], "]"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"k", ",", "kpath1"}], "}"}]}], "]"}]}]}]}], "]"}]}], ";", 
