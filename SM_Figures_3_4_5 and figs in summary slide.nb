Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"h3", "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_"}], "}"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"c", "=", 
        RowBox[{
         RowBox[{"p3", "[", "\"\<E1\>\"", "]"}], "+", 
         RowBox[{
          RowBox[{"p3", "[", "\"\<A1\>\"", "]"}], " ", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["x", "2"], "+", 
            SuperscriptBox["y", "2"]}], ")"}]}]}]}], ",", 
       RowBox[{"v", "=", 
        RowBox[{
         RowBox[{"p3", "[", "\"\<E2\>\"", "]"}], "+", 
         RowBox[{
          RowBox[{"p3", "[", "\"\<A2\>\"", "]"}], " ", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["x", "2"], "+", 
            SuperscriptBox["y", "2"]}], ")"}]}]}]}], ",", 
       RowBox[{"b", "=", 
        RowBox[{"p3", "[", "\"\<B0\>\"", "]"}]}], ",", 
       RowBox[{"r", "=", 
        RowBox[{"p3", "[", "\"\<R0\>\"", "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"c", ",", 
         RowBox[{"\[ImaginaryI]", " ", "b", " ", 
          RowBox[{"(", 
           RowBox[{"x", "+", 
            RowBox[{"\[ImaginaryI]", " ", "y"}]}], ")"}]}], ",", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "r", " ", 
          RowBox[{"(", 
           RowBox[{"x", "-", 
            RowBox[{"\[ImaginaryI]", " ", "y"}]}], ")"}]}], ",", "0"}], "}"}],
        ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "b", " ", 
          RowBox[{"(", 
           RowBox[{"x", "-", 
            RowBox[{"\[ImaginaryI]", " ", "y"}]}], ")"}]}], ",", "v", ",", 
         "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[ImaginaryI]", " ", "r", " ", 
          RowBox[{"(", 
           RowBox[{"x", "+", 
            RowBox[{"\[ImaginaryI]", " ", "y"}]}], ")"}]}], ",", "0", ",", 
         "c", ",", 
         RowBox[{"\[ImaginaryI]", " ", "b", " ", 
          RowBox[{"(", 
           RowBox[{"x", "-", 
            RowBox[{"\[ImaginaryI]", " ", "y"}]}], ")"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "b", " ", 
          RowBox[{"(", 
           RowBox[{"x", "+", 
            RowBox[{"\[ImaginaryI]", " ", "y"}]}], ")"}]}], ",", "v"}], 
        "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"ecb7405e-8446-b94a-bda6-e03cad586ae9"],

