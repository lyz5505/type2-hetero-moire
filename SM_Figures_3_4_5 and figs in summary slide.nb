Cell["Slide 21: band crossing and C3 eigenvalues (ratio 0.1)", "Subsubsection",ExpressionUUID->"22222ffc-ee29-0c47-9186-d38c77e72208"],

Cell[BoxData[
 RowBox[{"Clear", "@", "c3m"}]], "Input",
 CellLabel->
  "In[206]:=",ExpressionUUID->"1810d955-8a8b-094e-a1c6-444fa618cc5e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Gforoff", "=", 
   RowBox[{"FullSimplify", "@", 
    RowBox[{"G", "[", "1", "]"}]}]}], ";", 
  RowBox[{"zero2", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"0", ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "2"}], "}"}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"c3m", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Gforoff", "[", 
       RowBox[{"[", "i", "]"}], "]"}], "==", 
      RowBox[{
       RowBox[{"RotationMatrix", "[", 
        RowBox[{"2", 
         RowBox[{"Pi", "/", "3"}]}], "]"}], ".", 
       RowBox[{"Gforoff", "[", 
        RowBox[{"[", "j", "]"}], "]"}]}]}], ",", "c3", ",", "zero2"}], 
    "]"}]}], ";", 
  RowBox[{"C3m", "=", 
   RowBox[{"ArrayFlatten", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"c3m", "[", 
       RowBox[{"i", ",", "k"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Total", "@", "Glength"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", 
        RowBox[{"Total", "@", "Glength"}]}], "}"}]}], "]"}]}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[207]:=",ExpressionUUID->"4375bc29-3425-0c45-a47c-7657f5f5f642"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"translation", "[", 
     RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Gforoff", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "==", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"gg2", "[", "1", "]"}]}], "+", 
        RowBox[{"Gforoff", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}]}], ",", 
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], "]"}], ",", "zero2"}], "]"}]}], ";", 
   RowBox[{"Tran", "=", 
    RowBox[{"N", "@", 
     RowBox[{"ArrayFlatten", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"translation", "[", 
         RowBox[{"i", ",", "k"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Total", "@", "Glength"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", 
          RowBox[{"Total", "@", "Glength"}]}], "}"}]}], "]"}]}]}]}], 
   ";"}]}]], "Input",
 CellLabel->
  "In[208]:=",ExpressionUUID->"85775f07-7b21-d945-ba4b-a93cd0205c4f"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"translation2", "[", 
     RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Gforoff", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "==", 
       RowBox[{
        RowBox[{"gg2", "[", "1", "]"}], "+", 
