    RowBox[{"raw5pb", "[", "\"\<energies\>\"", "]"}], "\[LeftDoubleBracket]", 
    RowBox[{"All", ",", 
     RowBox[{"7", ";;", "8"}]}], "\[RightDoubleBracket]"}]}], ";", 
