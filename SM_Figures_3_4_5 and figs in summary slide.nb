Cell[BoxData[
 RowBox[{
  RowBox[{"x3", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
          "#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "]"}],
          ">", 
         FractionBox["1", 
          SuperscriptBox["10", "9"]]}], ",", 
        RowBox[{
         RowBox[{"-", "4"}], " ", "\[Pi]", " ", 
         RowBox[{
         "#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ",", 
        FractionBox[
         RowBox[{"4", " ", "\[Pi]", " ", 
          RowBox[{
          "#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
         SqrtBox["3"]]}], "]"}], "&"}], ")"}], "/@", 
    RowBox[{
     RowBox[{"raw3", "[", "\"\<kpoints\>\"", "]"}], "\[LeftDoubleBracket]", 
     "ids3", "\[RightDoubleBracket]"}]}]}], ";"}]], "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"8cc8038f-ab86-7441-87b6-793555fbf25c"],

