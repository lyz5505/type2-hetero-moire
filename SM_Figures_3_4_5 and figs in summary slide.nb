Cell[BoxData[
 RowBox[{
  RowBox[{"num", "=", "100"}], ";", 
  RowBox[{"B1", "=", 
   RowBox[{"gg2", "[", "TA", "]"}]}], ";", 
  RowBox[{"B2", "=", 
   RowBox[{"gg3", "[", "TA", "]"}]}], ";", 
  RowBox[{"num2", "=", "200"}], ";", 
  RowBox[{
   RowBox[{"INTDOT", "[", "k_List", "]"}], ":=", 
   RowBox[{
    RowBox[{"Im", "[", 
     RowBox[{"Chop", "@", 
      RowBox[{"Log", "[", 
       RowBox[{"Chop", "@", 
        RowBox[{"Eigenvalues", "[", 
         RowBox[{"Apply", "[", 
          RowBox[{"Dot", ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Conjugate", "[", 
               RowBox[{"k", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "]"}], ".", 
              RowBox[{"Transpose", "[", 
               RowBox[{"k", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1"}], "]"}], "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", "num2"}], "}"}]}], "]"}]}], "]"}], 
         "]"}]}], "]"}]}], "]"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", "Pi"}], ")"}]}]}], ";", 
  RowBox[{"Irange", "=", 
   RowBox[{"Flatten", "@", 
    RowBox[{"Append", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{"i", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", 
          RowBox[{"num2", "-", "1"}]}], "}"}]}], "]"}], ",", "0"}], "]"}]}]}],
   ";", 
  RowBox[{
   RowBox[{"WTPBUT", "[", "a_", "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", "=", 
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"EigPB", "[", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"a", "/", "num"}], " ", "B1"}], "+", 
           RowBox[{
            RowBox[{"i", "/", "num2"}], " ", "B2"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", 
           RowBox[{"num2", "-", "1"}]}], "}"}]}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"INTDOT", "[", 
      RowBox[{"Append", "[", 
       RowBox[{"t", ",", 
        RowBox[{"Transpose", "[", 
         RowBox[{"Tran2", ".", 
          RowBox[{"Transpose", "[", 
           RowBox[{"t", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], "]"}], "]"}]}], 
    "]"}]}], ";", 
  RowBox[{
   RowBox[{"WTPBUT2", "[", "a_", "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", "=", 
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"EigPB", "[", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"a", "/", "num"}], " ", "B1"}], "+", 
           RowBox[{
            RowBox[{"i", "/", "num2"}], " ", "B2"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", 
           RowBox[{"num2", "-", "1"}]}], "}"}]}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"INTDOT", "[", 
      RowBox[{"Append", "[", 
       RowBox[{"t", ",", 
        RowBox[{"Transpose", "[", 
         RowBox[{"Tran4", ".", 
          RowBox[{"Transpose", "[", 
           RowBox[{"t", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], "]"}], "]"}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[153]:=",ExpressionUUID->"c1873509-cb5c-d04c-b8a8-4a74a23ff209"],

