Cell["Explicit Hamiltonian helpers", "Text",ExpressionUUID->"c7d4268e-0fab-b245-b5c6-08fc9e3e681d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Helpers", " ", "for", " ", "the", " ", "explicit", " ", "Hamiltonians", " ", 
     RowBox[{"below", ".", "\n", "   ", 
      RowBox[{"smShowH", ":", " ", 
       RowBox[{
        RowBox[{"display", " ", "H", " ", "with", " ", "k"}], 
        "\[PlusMinus]"}]}]}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"kx", " ", "\[PlusMinus]", " ", 
      RowBox[{"i", " ", "ky", " ", "and", " ", 
       RowBox[{"k", "^", "2"}]}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"kx", "^", "2"}], "+", 
      RowBox[{
       RowBox[{"ky", "^", "2."}], "\n", "   ", 
       RowBox[{"smNumH", ":", " ", 
        RowBox[{
        "the", " ", "same", " ", "matrix", " ", "with", " ", "the", " ", 
         "numerical", " ", "parameters", " ", "of", " ", "association", " ", 
         "p", " ", 
         RowBox[{"substituted", ".", "\n", "   ", "smCheckH"}]}], ":", " ", 
        RowBox[{
        "confirms", " ", "the", " ", "symbolic", " ", "H", " ", "equals", " ",
          "the", " ", "numerical", " ", "model", " ", "h", " ", "at", " ", 
         "random", " ", 
         RowBox[{"k", "."}]}]}]}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"smShowH", "[", "m_", "]"}], " ", ":=", " ", 
     RowBox[{"TraditionalForm", "[", 
      RowBox[{"MatrixForm", "[", 
       RowBox[{"m", " ", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"kx", " ", "+", " ", 
            RowBox[{"I", " ", "ky"}]}], " ", "->", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"k", ",", " ", "\"\<+\>\""}], "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"kx", " ", "-", " ", 
            RowBox[{"I", " ", "ky"}]}], " ", "->", " ", 
           RowBox[{"Subscript", "[", 
            RowBox[{"k", ",", " ", "\"\<-\>\""}], "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"kx", "^", "2"}], " ", "+", " ", 
            RowBox[{"ky", "^", "2"}]}], " ", "->", " ", 
           RowBox[{"k", "^", "2"}]}]}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"smNumH", "[", 
      RowBox[{"H_", ",", " ", "p_"}], "]"}], " ", ":=", " ", 
     RowBox[{"smShowH", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"H", "[", 
          RowBox[{"kx", ",", " ", "ky"}], "]"}], " ", "/.", " ", 
         RowBox[{"KeyValueMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Symbol", "[", "#1", "]"}], " ", "->", " ", "#2"}], " ", 
            "&"}], ",", " ", "p"}], "]"}]}], ")"}], " ", "/.", " ", 
       RowBox[{
        RowBox[{"Complex", "[", 
         RowBox[{"0.", ",", " ", "b_"}], "]"}], " ", ":>", " ", 
        RowBox[{"b", " ", 
         RowBox[{"Style", "[", "\"\<\[ImaginaryI]\>\"", "]"}]}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"smCheckH", "[", 
      RowBox[{"H_", ",", " ", "h_", ",", " ", "p_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"rules", " ", "=", " ", 
          RowBox[{"KeyValueMap", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Symbol", "[", "#1", "]"}], " ", "->", " ", "#2"}], " ",
              "&"}], ",", " ", "p"}], "]"}]}], ",", " ", 
         RowBox[{"pts", " ", "=", " ", 
          RowBox[{"RandomReal", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "0.3"}], ",", " ", "0.3"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"6", ",", " ", "2"}], "}"}]}], "]"}]}]}], "}"}], ",", 
       "\n", "   ", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"H", " ", "@@", " ", "#"}], ")"}], " ", "/.", " ", 
                "rules"}], ")"}], " ", "-", " ", 
              RowBox[{"h", "[", "#", "]"}]}], " ", "&"}], " ", "/@", " ", 
            "pts"}], "]"}], "]"}], "]"}], " ", "<", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "12"}]}]}]}], "]"}]}], ";"}]}]}]], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"5d4e78a0-2bfa-7a47-be56-28976b44c82b"],

