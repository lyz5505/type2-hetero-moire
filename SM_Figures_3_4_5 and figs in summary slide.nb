 CellLabel->
  "Out[185]=",ExpressionUUID->"d356a7e4-04ea-3f4a-963f-05a4c0ba4ee7"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"getgap", "[", "a_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "b", "}"}], ",", 
    RowBox[{
     RowBox[{"b", "=", 
      RowBox[{"a", "//", "Transpose"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"b", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "-", 
       RowBox[{"b", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "//", "Abs"}]}]}], "]"}]}]], "Input",
 CellLabel->
  "In[186]:=",ExpressionUUID->"67d50c5b-2068-8f46-9fa3-ba59dddcc1b7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"mlist", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"m", ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", "0.01", ",", "E1", ",", "0.0001"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Checkgap", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Eigenvalues", "[", 
       RowBox[{
        RowBox[{"TotalHam3", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", 
          RowBox[{"-", "m"}], ",", "1", ",", "0"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", 
           RowBox[{"dim", "/", "2"}]}], ",", 
          RowBox[{
           RowBox[{"1", 
            RowBox[{"dim", "/", "2"}]}], "+", "1"}]}], "}"}]}], "]"}], "-", 
      "10"}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", "mlist"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[187]:=",ExpressionUUID->"1052f8d8-7bbe-e440-9729-6efc01ae2c0c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "mlist"}], ",", 
      RowBox[{"getgap", "[", "Checkgap", "]"}]}], "}"}], "//", "Transpose"}], 
   ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
