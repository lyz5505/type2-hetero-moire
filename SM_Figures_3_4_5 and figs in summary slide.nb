Cell["Non-moire model (slide 13)", "Subsubsection",ExpressionUUID->"af09fc1a-7936-8441-93db-fdd8e5e1ad11"],

Cell["\<\
a0 = 0.4016 nm. Same matrix as h3 above with q = a0 k, but this code uses the \
rounded SI values A1 = 0.289, A2 = -0.434 (h3: 0.28856, -0.43440); max \
difference 0.27 meV for |k| <= 1.5/nm. H[{kx,ky}, m] = Hhetero + m \
diag(1,-1,1,-1) (checked exactly).\
\>", "Text",ExpressionUUID->"36cd17d9-9ae8-c946-bd27-8d3dfc1c9bd8"],

,

