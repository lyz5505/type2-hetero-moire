Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Kspace2", "=", 
   RowBox[{"N", "@", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"kx", ",", "ky"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"kx", ",", "0", ",", 
          RowBox[{"B1", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "dk"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"ky", ",", "0", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"B1", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "/", 
            RowBox[{"Sqrt", "[", "3", "]"}]}], "*", "2"}], ",", "dk"}], 
         "}"}]}], "]"}], ",", "1"}], "]"}]}]}], ";", 
  RowBox[{"Graphics", "[", 
