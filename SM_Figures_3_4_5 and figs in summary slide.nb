Notebook[{

Cell[CellGroupData[{
Cell["SM Figures 3-5: original models and figure reproduction", "Title",ExpressionUUID->"9a7a1d92-e878-1945-ad5a-a58c71d5f9ef"],

Cell["\<\
Three material sections. All executable code is inside this notebook. \
Evaluate top to bottom; no optimization is performed. Keep data/ beside this \
notebook. Original figure conventions are retained and explained where they \
differ from SI text or raw k-point labels.\
\>", "Text",ExpressionUUID->"85bcde15-55dd-de48-9146-e10b2b21f5ff"],

,

