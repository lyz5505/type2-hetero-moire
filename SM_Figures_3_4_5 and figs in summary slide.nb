Cell["\<\
Berry curvature and Chern number of the red band at Delta m = -0.016 (slide \
19, C = 1).\
\>", "Text",ExpressionUUID->"2890c87f-81ef-9a4c-8d90-3f27cbb74df2"],
,

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ESGEhalf", "[", 
    RowBox[{"k_List", ",", "n_", ",", "M_", ",", "v_", ",", "Lambda_"}], 
    "]"}], ":=", 
   RowBox[{"Normalize", "@", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Eigenvectors", "[", 
      RowBox[{
       RowBox[{"TotalHam3", "[", 
        RowBox[{"k", ",", "M", ",", "v", ",", "Lambda"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"dim", "/", "2"}], "+", "n"}], "}"}]}], "]"}], "]"}]}]}], ";", 
  RowBox[{
   RowBox[{"Eighalf", "[", "k_List", "]"}], ":=", 
   RowBox[{"N", "@", 
    RowBox[{"Chop", "@", 
     RowBox[{"ESGEhalf", "[", 
      RowBox[{"k", ",", "1", ",", 
       RowBox[{"-", "0.016"}], ",", "1"}], "]"}]}]}]}]}]], "Input",
 CellLabel->
  "In[190]:=",ExpressionUUID->"195d2755-5e1f-0c46-a0b3-9fe06602865d"],

