            RowBox[{"Gtest", "[", 
             RowBox[{"[", "j", "]"}], "]"}], "-", 
            RowBox[{
             RowBox[{"RotationMatrix", "[", 
              RowBox[{"2", 
               RowBox[{"Pi", "/", "3"}], "k"}], "]"}], ".", 
             RowBox[{"gg2", "[", "TA", "]"}]}]}], "]"}]}], "<=", 
         RowBox[{
          RowBox[{"Norm", "[", 
           RowBox[{"gg2", "[", "TA", "]"}], "]"}], "/", "100"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"off", "[", 
           RowBox[{"[", "k", "]"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", "1"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Total", "@", "Glength"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", 
        RowBox[{"Total", "@", "Glength"}]}], "}"}]}], "]"}], ",", 
