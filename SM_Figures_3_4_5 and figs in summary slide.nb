Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"h5pb", "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_"}], "}"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"p5pb", "[", "\"\<E0\>\"", "]"}], "+", 
      RowBox[{
       RowBox[{"p5pb", "[", "\"\<A\>\"", "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["x", "2"], "+", 
         SuperscriptBox["y", "2"]}], ")"}]}]}], ")"}], " ", 
    RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[58]:=",ExpressionUUID->"97b9b1e4-c986-2b4f-8695-515c7b5efc1b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"h5ti", "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_"}], "}"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"p5ti", "[", "\"\<E0\>\"", "]"}], "+", 
       RowBox[{
        RowBox[{"p5ti", "[", "\"\<A\>\"", "]"}], " ", 
