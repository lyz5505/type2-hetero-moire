Cell[CellGroupData[{

Cell["3. PbS2/TiTe2  -  Fig. 5(a-c)", "Section",ExpressionUUID->"9121d96a-7ff3-e544-8d4e-046c18b131ff"],

Cell["\<\
Figure-reproduction convention: panel (c) deliberately retains the original \
notebook mapping of the heterostructure rows onto the single-layer M-Gamma-X \
path and its removal of points 34 and 37 from the highest displayed band. The \
heterostructure JSON itself labels Y-Gamma-X. These are legacy figure \
conventions, not a correction to the raw data.\
\>", "Text",ExpressionUUID->"d91b75e4-6838-4b4b-aa68-5471bb86afad"],

C,

Cell[CellGroupData[{

Cell["Single-layer models and Fig. 5(a,b)", "Subsection",ExpressionUUID->"70a49536-581e-a94e-89a4-f94abcacb7dd"],

Cell["\<\
Fig. 5(a) uses the notebook values E0=-3.338 and A=0.5130408579060275 (SI: \
-3.338, 0.51304). Both single-layer models retain the original parameters.\
\>", "Text",ExpressionUUID->"7b171f21-5211-1849-a33c-53a017d5503a"],
,

Cell[BoxData[
 RowBox[{
  RowBox[{"p5pb", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<E0\>\"", "\[Rule]", 
      RowBox[{"-", "3.338`"}]}], ",", 
     RowBox[{"\"\<A\>\"", "\[Rule]", 
      RowBox[{"0.4370408579060275`", "\[VeryThinSpace]", "+", "0.076`"}]}]}], 
    "]"}]}], ";"}]], "Input",
