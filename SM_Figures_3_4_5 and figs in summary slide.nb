Cell["Heterostructure model and Fig. 5(c)", "Subsection",ExpressionUUID->"019cba29-c659-3843-8ddd-8c4f9f6c7b39"],

Cell[BoxData[
 RowBox[{
  RowBox[{"p5", "=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<E0\>\"", "\[Rule]", 
      RowBox[{"-", "0.0125`"}]}], ",", 
     RowBox[{"\"\<E1\>\"", "\[Rule]", "0.0125`"}], ",", 
     RowBox[{"\"\<A\>\"", "\[Rule]", "0.398`"}], ",", 
     RowBox[{"\"\<B\>\"", "\[Rule]", 
      RowBox[{"-", "0.573`"}]}], ",", 
     RowBox[{"\"\<R0\>\"", "\[Rule]", 
      RowBox[{"-", "0.056`"}]}], ",", 
     RowBox[{"\"\<RA\>\"", "\[Rule]", "0.044`"}], ",", 
     RowBox[{"\"\<TB\>\"", "\[Rule]", 
      RowBox[{"0.1488`", " ", "\[ImaginaryI]"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[77]:=",ExpressionUUID->"d54b9ed7-bb5c-f342-a1c2-1684776cfe28"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"h5", "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_"}], "}"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"v", "=", 
        RowBox[{
         RowBox[{"p5", "[", "\"\<E0\>\"", "]"}], "+", 
         RowBox[{
          RowBox[{"p5", "[", "\"\<B\>\"", "]"}], " ", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["x", "2"], "+", 
            SuperscriptBox["y", "2"]}], ")"}]}]}]}], ",", 
       RowBox[{"c", "=", 
        RowBox[{
         RowBox[{"p5", "[", "\"\<E1\>\"", "]"}], "+", 
         RowBox[{
          RowBox[{"p5", "[", "\"\<A\>\"", "]"}], " ", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["x", "2"], "+", 
            SuperscriptBox["y", "2"]}], ")"}]}]}]}], ",", 
       RowBox[{"r", "=", 
        RowBox[{"p5", "[", "\"\<R0\>\"", "]"}]}], ",", 
       RowBox[{"a", "=", 
        RowBox[{"p5", "[", "\"\<RA\>\"", "]"}]}], ",", 
       RowBox[{"t", "=", 
        RowBox[{"p5", "[", "\"\<TB\>\"", "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"v", ",", 
         RowBox[{"r", " ", 
          RowBox[{"(", 
           RowBox[{"x", "-", 
            RowBox[{"\[ImaginaryI]", " ", "y"}]}], ")"}]}], ",", 
         RowBox[{
          RowBox[{"a", " ", "x"}], "+", 
          RowBox[{"t", " ", "y"}]}], ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"r", " ", 
          RowBox[{"(", 
           RowBox[{"x", "+", 
            RowBox[{"\[ImaginaryI]", " ", "y"}]}], ")"}]}], ",", "v", ",", 
         "0", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "a"}], " ", "x"}], "+", 
          RowBox[{"t", " ", "y"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"a", " ", "x"}], "+", 
          RowBox[{
           RowBox[{"Conjugate", "[", "t", "]"}], " ", "y"}]}], ",", "0", ",", 
         "c", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "a"}], " ", "x"}], "+", 
          RowBox[{
           RowBox[{"Conjugate", "[", "t", "]"}], " ", "y"}]}], ",", "0", ",", 
         "c"}], "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[78]:=",ExpressionUUID->"72f4706f-2eca-d944-8a29-aaa24e161660"],

