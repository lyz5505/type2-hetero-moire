      "own", " ", "context", " ", "so", " ", "that", " ", "E1"}], ",", " ", 
    "B0", ",", " ", "H", ",", " ", 
    RowBox[{
    "...", " ", "do", " ", "not", " ", "clash", " ", "with", " ", "the", " ", 
     "SM", " ", "models", " ", "above"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"moire`saved", " ", "=", " ", "$ContextPath"}], ";", " ", 
