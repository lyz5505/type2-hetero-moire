Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"translation2", "[", 
     RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Gforoff", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "==", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"gg3", "[", "1", "]"}]}], "+", 
        RowBox[{"Gforoff", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}]}], ",", "one4", ",", "zero4"}], 
     "]"}]}], ";", 
   RowBox[{"Tran2", "=", 
    RowBox[{"N", "@", 
     RowBox[{"ArrayFlatten", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"translation2", "[", 
         RowBox[{"i", ",", "k"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Total", "@", "Glength"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", 
          RowBox[{"Total", "@", "Glength"}]}], "}"}]}], "]"}]}]}]}], ";", " ", 
   RowBox[{
    RowBox[{"translation3", "[", 
     RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Gforoff", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "==", 
       RowBox[{
        RowBox[{"gg3", "[", "1", "]"}], "+", 
        RowBox[{"Gforoff", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}]}], ",", "one4", ",", "zero4"}], 
     "]"}]}], ";", 
   RowBox[{"Tran3", "=", 
    RowBox[{"N", "@", 
     RowBox[{"ArrayFlatten", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"translation3", "[", 
         RowBox[{"i", ",", "k"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Total", "@", "Glength"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", 
          RowBox[{"Total", "@", "Glength"}]}], "}"}]}], "]"}]}]}]}], ";"}], 
  " "}]], "Input",
 CellLabel->
  "In[151]:=",ExpressionUUID->"49debedc-570f-a945-8efc-0e46ae2b3667"],

