Cell["\<\
Gap size at Gamma versus Delta m. NOTE: E1 is reused here only as the upper \
end of the m range; HInt was already built, so the Hamiltonian is not changed.\
\>", "Text",ExpressionUUID->"702af437-712d-584c-a9b3-27d50ef9bccd"],
,

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"E1", "=", "0.024"}]], "Input",
