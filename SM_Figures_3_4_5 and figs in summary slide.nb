Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"smCurves", "[", 
    RowBox[{"x_", ",", "e_"}], "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     TemplateBox[{
       RowBox[{"{", 
         RowBox[{"x", ",", 
           RowBox[{"e", "\[LeftDoubleBracket]", 
             RowBox[{"All", ",", "j"}], "\[RightDoubleBracket]"}]}], "}"}]},
      "Transpose"], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", 
       RowBox[{"Length", "[", 
        RowBox[{"First", "[", "e", "]"}], "]"}]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"ad00c1a3-7143-694e-89a2-8a40718be083"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"smBands", "[", 
    RowBox[{"h_", ",", "q_"}], "]"}], ":=", 
   RowBox[{"Sort", "[", 
    RowBox[{"Re", "[", 
     RowBox[{"Eigenvalues", "[", 
      RowBox[{"N", "[", 
       RowBox[{"h", "[", "q", "]"}], "]"}], "]"}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"c44afb84-c9b5-4749-940c-a185e70f95ac"],

