Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"smSquareQ", "[", "t_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"t", "<", "0"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["t", 
         SqrtBox["2"]]}], ",", 
       RowBox[{"-", 
        FractionBox["t", 
         SqrtBox["2"]]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "t"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[71]:=",ExpressionUUID->"75c75055-c6b2-9b4b-bb4c-f6e9d369e774"],

