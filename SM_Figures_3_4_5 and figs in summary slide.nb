Cell[CellGroupData[{

Cell["Slide 15: Wilson loop", "Subsubsection",ExpressionUUID->"530bd24a-7ded-ad47-a1f0-34465eaec997"],

Cell["\<\
NOTE: in the original notebook these EigPB cells call the 3-argument form \
TotalHam3[k, M, -1], which does not exist in this 55 nm section (TotalHam3[k, \
M, V, Lambda]). They are changed to TotalHam3[k, M, 1, 0.3], the slide-14 \
parameters (same Delta m values). With V = +1 or -1 the Gamma gap closes at \
the same Delta m = -0.0375.\
\>", "Text",ExpressionUUID->"0d0d3793-c92f-6c4c-8e65-82c97e4694f0"],

C,

