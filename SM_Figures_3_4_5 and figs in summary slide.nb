Cell["Gap size at Gamma versus Delta m (slide 14, right).", "Text",ExpressionUUID->"8e31573c-2626-e94a-8a0c-19d029fc00d8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mlist", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"m", ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", "0.03", ",", "0.045", ",", 
       RowBox[{"0.0001", "/", "2"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[138]:=",ExpressionUUID->"4a5042fc-eed3-8240-af71-de7908895438"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Checkgap", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Eigenvalues", "[", 
       RowBox[{
        RowBox[{"TotalHam3", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", 
          RowBox[{"-", "m"}], ",", "1", ",", "0.3"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", 
           RowBox[{"dim", "/", "2"}]}], ",", 
          RowBox[{
           RowBox[{"1", 
            RowBox[{"dim", "/", "2"}]}], "+", "1"}]}], "}"}]}], "]"}], "-", 
      "10"}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", "mlist"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[139]:=",ExpressionUUID->"452c36f9-f099-ba4f-ab77-ff9c0b048166"],

Cell[BoxData[
 RowBox[{
  RowBox[{"getgap", "[", "a_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "b", "}"}], ",", 
    RowBox[{
     RowBox[{"b", "=", 
      RowBox[{"a", "//", "Transpose"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"b", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "-", 
       RowBox[{"b", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "//", "Abs"}]}]}], "]"}]}]], "Input",
 CellLabel->
  "In[140]:=",ExpressionUUID->"81a6a598-b7d3-b444-91f4-c2988aaf96a1"],

Cell[CellGroupData[{

