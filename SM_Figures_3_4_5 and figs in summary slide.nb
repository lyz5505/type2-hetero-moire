Cell[CellGroupData[{

Cell["1. HgCl2/PtTe2  -  Fig. 3", "Section",ExpressionUUID->"b01d0bd1-0f46-8a43-bf25-508d259c3a1b"],

Cell["\<\
Original HgCl2/PtTe2 four-band model. Energy reference: subtract 0.1649 eV. \
The path is 0.15K-Gamma-0.15M. Curvatures are the full-precision values of \
the original notebook (SI quotes them to five decimals).\
\>", "Text",ExpressionUUID->"7eb6079d-3c18-754d-b8ab-e8b394c6e473"],
,

