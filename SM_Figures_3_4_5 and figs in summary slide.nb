Cell[CellGroupData[{

Cell["4. Moire calculations (summary slides 13-24)", "Section",ExpressionUUID->"9ecebbc9-28f7-9c4a-a388-0e238f86cb08"],

Cell["\<\
Code collected from \"heavy fermion material all.nb\" for slides 13-24 of \
type2_summary_Yunzhe.pptx. Cells are copied unchanged except where marked \
NOTE. Run sections 1-3 first only if needed; this section is independent. \
Band/gap cells use ParallelTable; Wilson loops and Berry curvature are slow \
(minutes each).\
\>", "Text",ExpressionUUID->"14748b7b-c050-ef4b-a784-77f0cebdbd7c"],

C,

