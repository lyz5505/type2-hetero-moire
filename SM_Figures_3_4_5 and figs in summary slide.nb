Cell[BoxData[
 RowBox[{
  RowBox[{"BZ0", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"RotationMatrix", "[", 
       RowBox[{"2", 
        RowBox[{"Pi", "/", "6"}], " ", "J"}], "]"}], ".", "mkK"}], ",", 
     RowBox[{"{", 
      RowBox[{"J", ",", "0", ",", "6", ",", "1"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"BZ1", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"RotationMatrix", "[", 
        RowBox[{"2", 
         RowBox[{"Pi", "/", "6"}], " ", "J"}], "]"}], ".", "mkK"}], "-", 
      RowBox[{"gg1", "[", "TA", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"J", ",", "0", ",", "6", ",", "1"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"BZ2", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"RotationMatrix", "[", 
        RowBox[{"2", 
         RowBox[{"Pi", "/", "6"}], " ", "J"}], "]"}], ".", "mkK"}], "+", 
      RowBox[{"gg3", "[", "TA", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"J", ",", "0", ",", "6", ",", "1"}], "}"}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"Tr1", "[", "k_List", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"RegionMember", "[", 
       RowBox[{
        RowBox[{"Polygon", "@", "BZ1"}], ",", "k"}], "]"}], "==", "True"}], ",", 
     RowBox[{"k", "+", 
      RowBox[{"gg1", "[", "TA", "]"}]}], ",", "k"}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"Tr2", "[", "k_List", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"RegionMember", "[", 
       RowBox[{
        RowBox[{"Polygon", "@", "BZ2"}], ",", "k"}], "]"}], "==", "True"}], ",", 
     RowBox[{"k", "-", 
      RowBox[{"gg3", "[", "TA", "]"}]}], ",", "k"}], "]"}]}], ";", 
  RowBox[{"Kspace2Tr1", "=", 
   RowBox[{"Map", "[", 
    RowBox[{"Tr1", ",", "Kspace2"}], "]"}]}], ";", 
  RowBox[{"Kspace2Tr2", "=", 
   RowBox[{"Map", "[", 
    RowBox[{"Tr2", ",", "Kspace2Tr1"}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[195]:=",ExpressionUUID->"9f60461f-7d71-1145-a678-a0dbd719eba4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BC", "[", 
   RowBox[{"{", 
    RowBox[{"kx_", ",", "ky_"}], "}"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"t", "=", 
       RowBox[{"Eighalf", "[", 
        RowBox[{"{", 
         RowBox[{"kx", ",", "ky"}], "}"}], "]"}]}], ",", 
      RowBox[{"tdx", "=", 
       RowBox[{"Eighalf", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"kx", "+", "dk"}], ",", "ky"}], "}"}], "]"}]}], ",", 
      RowBox[{"tdy", "=", 
       RowBox[{"Eighalf", "[", 
        RowBox[{"{", 
         RowBox[{"kx", ",", 
          RowBox[{"ky", "+", "dk"}]}], "}"}], "]"}]}], ",", 
      RowBox[{"tdydx", "=", 
       RowBox[{"Eighalf", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"kx", "+", "dk"}], ",", 
          RowBox[{"ky", "+", "dk"}]}], "}"}], "]"}]}]}], "}"}], ",", 
    RowBox[{"-", 
     RowBox[{"Im", "@", 
      RowBox[{"Log", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Conjugate", "[", "t", "]"}], ".", "tdx"}], ")"}], 
        RowBox[{"(", " ", 
         RowBox[{
          RowBox[{"Conjugate", "[", "tdx", "]"}], ".", "tdydx"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Conjugate", "[", "tdydx", "]"}], ".", "tdy"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Conjugate", "[", "tdy", "]"}], ".", "t"}], ")"}]}], 
       "]"}]}]}]}], "]"}]}]], "Input",
 CellLabel->
  "In[196]:=",ExpressionUUID->"7c1de0d2-3156-3f49-a944-85614bb0f31d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Eighalf", "[", "k_List", "]"}], ":=", 
  RowBox[{"N", "@", 
   RowBox[{"Chop", "@", 
    RowBox[{"ESGEhalf", "[", 
     RowBox[{"k", ",", "1", ",", 
      RowBox[{"-", "0.016"}], ",", "1", ",", "0"}], "]"}]}]}]}]], "Input",
 CellLabel->
  "In[197]:=",ExpressionUUID->"088b3778-3788-7846-a13e-9e31794a2b58"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BCAll", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"BC", "[", "k", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "Kspace2"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[198]:=",ExpressionUUID->"7e57dda4-5a2d-9d47-a9ed-28b9af7361f0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Total", "[", "BCAll", "]"}], "/", "2"}], "/", "Pi"}]], "Input",
 CellLabel->
  "In[199]:=",ExpressionUUID->"3bc25d7e-ea45-6149-8a87-b93bde309bde"],

Cell[BoxData["1.0310632115759573`"], "Output",
 CellChangeTimes->{4.0037020806855106`*^9},
 CellLabel->
  "Out[199]=",ExpressionUUID->"c68b877a-2b5f-9e46-8990-28a6f4c94e01"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListDensityPlot", "[", 
  RowBox[{
   RowBox[{"Map", "[", 
    RowBox[{"Flatten", ",", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"Kspace2Tr2", ",", 
        RowBox[{
         RowBox[{"BCAll", "/", "dk"}], "/", "dk"}]}], "}"}], "]"}]}], "]"}], ",", 
   RowBox[{"ColorFunction", "\[Rule]", "\"\<TemperatureMap\>\""}], ",", 
   RowBox[{"PlotLegends", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"InterpolationOrder", "\[Rule]", "All"}], ",", 
