         RowBox[{"[", "j", "]"}], "]"}]}]}], ",", 
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], "]"}], ",", "zero2"}], "]"}]}], ";", 
