Cell[CellGroupData[{

Cell["2. HgCl2/TiTe2  -  Fig. 4(a), inset, and Fig. 4(b)", "Section",ExpressionUUID->"d422519d-dfb4-fb42-b7c6-fc444d108424"],

Cell["\<\
Panel (a): full TiTe2 DFT bands and a two-band inset. Panel (b): \
heterostructure four-band model, using the final Hfit4Best model of the \
original notebook (cubic trigonal warping -W ky (3 kx^2-ky^2) plus a quartic \
valence-band term L (kx^2+ky^2)^2). Same model and parameters as SI Eq. (11). \
No parameters are re-fitted.\
\>", "Text",ExpressionUUID->"66e37b39-007c-7d48-8d80-c9beb42ed847"],

C,

Cell[CellGroupData[{

Cell["Single-layer parameters, full path and inset", "Subsection",ExpressionUUID->"464c7b91-6980-3040-8438-e9a7c1fdf8fc"],

Cell["\<\
Single-layer model of SI Eq. (10): (E0 + A k^2) sigma0 + W ky (3 kx^2 - ky^2) \
sigma3. Only time-reversal-symmetric terms are kept; the TR-odd scalar cubic \
term C3 kx (kx^2 - 3 ky^2) of the original notebook (C3 = 0.02) is removed.\
\>", "Text",ExpressionUUID->"2ef87628-6d7b-6444-a903-5bc6e8862ff1"],
,

Cell[BoxData[
 RowBox[{
  RowBox[{"p4mono", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<E0\>\"", " ", "->", " ", 
      RowBox[{"-", "0.14"}]}], ",", " ", 
     RowBox[{"\"\<A\>\"", " ", "->", " ", 
      RowBox[{"-", "0.266"}]}], ",", " ", 
     RowBox[{"\"\<W\>\"", " ", "->", " ", 
      RowBox[{"-", "0.164"}]}]}], "|>"}]}], ";"}]], "Input",
 CellLabel->"In[27]:=",ExpressionUUID->"cf27f03e-f7bc-d44b-a320-eeaf79b2e875"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"h4mono", "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", " ", "y_"}], "}"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"p4mono", "[", "\"\<E0\>\"", "]"}], " ", "+", " ", 
       RowBox[{
        RowBox[{"p4mono", "[", "\"\<A\>\"", "]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"x", "^", "2"}], " ", "+", " ", 
          RowBox[{"y", "^", "2"}]}], ")"}]}]}], ")"}], " ", 
     RowBox[{"IdentityMatrix", "[", "2", "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"p4mono", "[", "\"\<W\>\"", "]"}], " ", "y", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", " ", 
        RowBox[{"x", "^", "2"}]}], " ", "-", " ", 
       RowBox[{"y", "^", "2"}]}], ")"}], " ", 
     RowBox[{"PauliMatrix", "[", "3", "]"}]}]}]}], ";"}]], "Input",
 CellLabel->"In[28]:=",ExpressionUUID->"9eda7054-c9da-2041-bf5c-40f0ed170a7d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Fig", ".", " ", "4"}], 
    RowBox[{"(", "a", ")"}], "  ", "TiTe2", " ", "single", " ", 
    RowBox[{"layer", ":", " ", 
     RowBox[{"explicit", " ", "2", "x2", " ", "Hamiltonian", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"SI", " ", 
         RowBox[{"Eq", ".", " ", "10"}]}], ";", " ", 
        RowBox[{"TR", "-", "symmetric"}]}], ")"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"H4mono", "[", 
      RowBox[{"kx_", ",", " ", "ky_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"E0", " ", "+", " ", 
         RowBox[{"A", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"kx", "^", "2"}], " ", "+", " ", 
            RowBox[{"ky", "^", "2"}]}], ")"}]}]}], ")"}], " ", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}], " ", "+", " ", 
      RowBox[{"W", " ", "ky", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"3", " ", 
          RowBox[{"kx", "^", "2"}]}], " ", "-", " ", 
         RowBox[{"ky", "^", "2"}]}], ")"}], " ", 
       RowBox[{"PauliMatrix", "[", "3", "]"}]}]}]}], ";"}], "\n", 
   RowBox[{"smShowH", "[", 
    RowBox[{"H4mono", "[", 
     RowBox[{"kx", ",", " ", "ky"}], "]"}], "]"}], "\n", 
   RowBox[{"smNumH", "[", 
    RowBox[{"H4mono", ",", " ", "p4mono"}], "]"}], "\n", 
   RowBox[{"smCheckH", "[", 
