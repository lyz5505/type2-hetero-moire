Cell[BoxData[
 RowBox[{
  RowBox[{"offall", "=", 
   RowBox[{
    RowBox[{"off", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "+", 
    RowBox[{"off", "[", 
     RowBox[{"[", "2", "]"}], "]"}], "+", 
    RowBox[{"off", "[", 
     RowBox[{"[", "3", "]"}], "]"}]}]}], ";", 
  RowBox[{
   RowBox[{"Hinterationn", "[", 
    RowBox[{"V_", ",", "Lambda_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"37.5", "/", 
     RowBox[{"(", 
      RowBox[{"3", "*", 
       RowBox[{"Sqrt", "[", "3", "]"}]}], ")"}]}], "*", " ", 
    RowBox[{
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Lambda", " ", "V"}], ",", "V"}], "}"}], "]"}], "/", 
     "1000"}]}]}], ";", 
  RowBox[{
   RowBox[{"diaH", "[", 
    RowBox[{"V_", ",", "Lambda_"}], "]"}], ":=", 
   RowBox[{"Chop", "@", 
    RowBox[{"N", "@", 
     RowBox[{"KroneckerProduct", "[", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"I", " ", "offall"}], "-", 
        RowBox[{"I", " ", 
         RowBox[{"Transpose", "@", "offall"}]}]}], ",", 
       RowBox[{"Hinterationn", "[", 
        RowBox[{"V", ",", "Lambda"}], "]"}]}], "]"}]}]}]}]}]], "Input",
 CellLabel->
  "In[176]:=",ExpressionUUID->"1f0124d1-07b5-e141-89d0-8cac1296081c"],

